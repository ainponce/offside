{
  "name": "offside",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma federal de órdenes de bloqueo en vivo contra transmisiones ilegales. Hackathon Argentina Space 2026, Desafío Fútbol.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev": "tsx watch --disable-warning=ExperimentalWarning src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --disable-warning=ExperimentalWarning --test pruebas/*.test.ts",
    "ensayo": "tsx --disable-warning=ExperimentalWarning scripts/ensayo.ts",
    "exportar": "tsx --disable-warning=ExperimentalWarning scripts/exportar.ts",
    "demo": "tsx --disable-warning=ExperimentalWarning scripts/demo.ts",
    "video": "tsx --disable-warning=ExperimentalWarning scripts/video.ts",
    "video:voz": "tsx --disable-warning=ExperimentalWarning scripts/narrar.ts",
    "jueces-locales": "tsx --disable-warning=ExperimentalWarning scripts/jueces-locales.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/faustina": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.7",
    "d3-geo": "^3.1.2",
    "d3-selection": "^3.0.1",
    "d3-transition": "^3.0.2",
    "d3-zoom": "^3.0.1",
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "world-atlas": "^2.0.2"
  }
}
